{
  "name": "evisa-contact-form",
  "version": "1.0.0",
  "description": "Contact form for eVisa when online chat is not available",
  "main": "index.js",
  "engines": {
    "node": ">=24.21.0 <25.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "start:dev": "hof-build watch --env ./.env",
    "start:devcontainer": "hof-build watch --env ./.devcontainer/devcontainer.env",
    "build": "hof-build",
    "postinstall": "hof-build",
    "test:e2e:generate": "bddgen --config playwright.config.ts",
    "test:e2e": "npm run test:e2e:generate && playwright test --config playwright.config.ts",
    "test:e2e:typecheck": "tsc --noEmit",
    "test:lint": "eslint . --config ./node_modules/eslint-config-hof/default.js",
    "test:unit": "nyc _mocha \"test/_unit/**/*.spec.js\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UKHomeOffice/evisa-contact-form.git"
  },
  "author": "HOF",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/UKHomeOffice/evisa-contact-form/issues"
  },
  "homepage": "https://github.com/UKHomeOffice/evisa-contact-form#readme",
  "dependencies": {
    "accessible-autocomplete": "^3.0.1",
    "busboy": "^1.6.0",
    "form-data": "^4.0.6",
    "hof": "~24.5.0",
    "lodash": "^4.18.1",
    "notifications-node-client": "^8.4.0"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.9",
    "@cucumber/cucumber": "^13.2.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^26.1.2",
    "chai": "^6.2.2",
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.5",
    "eslint": "^8.57.0",
    "eslint-config-hof": "^1.3.4",
    "mocha": "^12.0.0",
    "nyc": "^18.0.0",
    "playwright": "1.63.0",
    "playwright-bdd": "^9.2.1",
    "proxyquire": "^2.1.3",
    "reqres": "^3.0.1",
    "sinon": "^22.1.0",
    "sinon-chai": "^4.0.1",
    "typescript": "^7.0.2"
  },
  "mocha": {
    "reporter": "spec",
    "require": "test/common.js",
    "recursive": "true",
    "timeout": "9000",
    "exit": "true"
  },
  "resolutions": {
    "js-yaml": "^4.3.2",
    "morgan": "^1.12.0",
    "nanoid": "^3.3.18",
    "qs": "^6.16.0",
    "serialize-javascript": "^7.0.5"
  }
}
